# Copy to .env and fill in. The agent sets these when it provisions a bot.
BOT_TOKEN=123456:PUT-BOTFATHER-TOKEN-HERE
# SQLite (default, zero infra). To move to Postgres later, just change this line
# and the provider in prisma/schema.prisma — no code changes.
DATABASE_URL=file:./data/bot.db
# Public site for "Пополнить"/CTA links, referral share text, etc. (optional).
SITE_URL=https://agentflow.website
# Bot @username (for building referral deep-links). Optional; auto-detected if empty.
BOT_USERNAME=
